import Bong.Lattice.Projection

/-!
# Adjoining one vector to a full lattice

This file constructs the full lattice generated by a lattice `L` and one
additional ambient vector.  It also proves the geometric identity needed in
Beli (2019), Lemma 5.7: adjoining a scalar multiple of the projection axis
does not change the projected lattice.
-/

namespace Bong

open Dyadic

namespace Lattice

universe u v

variable {K : Type u} [Field K] [CharZero K] [ValuativeRel K]
  [TopologicalSpace K] [DyadicContext K]
  {V : Type v} [AddCommGroup V] [Module K V]

/-- The full lattice integrally generated by `L` and the vector `x`. -/
noncomputable def adjoinVector (L : Lattice K V) (x : V) : Lattice K V where
  toSubmodule := L.toSubmodule ⊔
    Submodule.span (IntegerRing K) ({x} : Set V)
  fg := L.fg.sup (Submodule.fg_span (Set.toFinite ({x} : Set V)))
  span_eq_top := by
    apply top_unique
    intro y _
    have hy : y ∈ Submodule.span K (L.toSubmodule : Set V) := by
      rw [L.span_eq_top]
      exact Submodule.mem_top
    exact Submodule.span_mono (fun _ hz ↦ Submodule.mem_sup_left hz) hy

@[simp]
theorem adjoinVector_toSubmodule (L : Lattice K V) (x : V) :
    (adjoinVector L x).toSubmodule = L.toSubmodule ⊔
      Submodule.span (IntegerRing K) ({x} : Set V) :=
  rfl

/-- Membership in `L[x]` is an integral linear combination of a vector of
`L` and the adjoined vector. -/
theorem mem_adjoinVector_iff {L : Lattice K V} {x z : V} :
    z ∈ adjoinVector L x ↔
      ∃ y ∈ L, ∃ c : IntegerRing K, y + c • x = z := by
  constructor
  · intro hz
    change z ∈ L.toSubmodule ⊔
      Submodule.span (IntegerRing K) ({x} : Set V) at hz
    rw [Submodule.mem_sup] at hz
    rcases hz with ⟨y, hy, w, hw, rfl⟩
    rcases Submodule.mem_span_singleton.mp hw with ⟨c, rfl⟩
    exact ⟨y, hy, c, rfl⟩
  · rintro ⟨y, hy, c, rfl⟩
    change y + c • x ∈ L.toSubmodule ⊔
      Submodule.span (IntegerRing K) ({x} : Set V)
    rw [Submodule.mem_sup]
    exact ⟨y, hy, c • x,
      Submodule.mem_span_singleton.mpr ⟨c, rfl⟩, rfl⟩

/-- The original lattice is contained in the one-vector enlargement. -/
theorem le_adjoinVector (L : Lattice K V) (x : V) : L ≤ adjoinVector L x :=
  fun _ hy ↦ Submodule.mem_sup_left hy

/-- The adjoined vector belongs to the enlarged lattice. -/
theorem mem_adjoinVector (L : Lattice K V) (x : V) : x ∈ adjoinVector L x := by
  rw [mem_adjoinVector_iff]
  exact ⟨0, L.zero_mem, 1, by simp⟩

/-- The one-vector enlargement is the least lattice containing both `L` and
the adjoined vector. -/
theorem adjoinVector_le {L M : Lattice K V} {x : V}
    (hLM : L ≤ M) (hx : x ∈ M) : adjoinVector L x ≤ M := by
  intro z hz
  have hz' : z ∈ adjoinVector L x := hz
  rw [mem_adjoinVector_iff] at hz'
  rcases hz' with ⟨y, hy, c, rfl⟩
  exact M.add_mem (hLM hy) (M.smul_mem c hx)

/-- Replacing the adjoined vector by a congruent vector modulo the original
lattice does not change the enlargement. -/
theorem adjoinVector_eq_of_sub_mem {L : Lattice K V} {x y : V}
    (hxy : x - y ∈ L) : adjoinVector L x = adjoinVector L y := by
  apply Lattice.ext
  apply le_antisymm
  · apply adjoinVector_le (le_adjoinVector L y)
    have hxSub : x - y ∈ adjoinVector L y :=
      le_adjoinVector L y hxy
    have hyMem : y ∈ adjoinVector L y := mem_adjoinVector L y
    have hsum := (adjoinVector L y).add_mem hxSub hyMem
    simpa only [sub_add_cancel] using hsum
  · apply adjoinVector_le (le_adjoinVector L x)
    have hxSub : x - y ∈ adjoinVector L x :=
      le_adjoinVector L x hxy
    have hxMem : x ∈ adjoinVector L x := mem_adjoinVector L x
    have hdiff := (adjoinVector L x).sub_mem hxMem hxSub
    simpa only [sub_sub_cancel] using hdiff

/-- Adjoining a vector already in the lattice changes nothing. -/
@[simp]
theorem adjoinVector_eq_self {L : Lattice K V} {x : V} (hx : x ∈ L) :
    adjoinVector L x = L := by
  apply Lattice.ext
  exact le_antisymm (adjoinVector_le (fun _ hy ↦ hy) hx)
    (le_adjoinVector L x)

/-- Adjoining a scalar multiple of the projection axis leaves its orthogonal
projection unchanged. -/
theorem projectedLattice_adjoinVector_smul
    (q : QuadraticSpace K V) (L : Lattice K V) (x : V)
    (anisotropic : q.IsAnisotropic x) (a : K) :
    projectedLattice q (adjoinVector L (a • x)) x anisotropic =
      projectedLattice q L x anisotropic := by
  apply Lattice.ext
  apply le_antisymm
  · intro y hy
    rcases (mem_projectedLattice_iff q
      (adjoinVector L (a • x)) x anisotropic y).1 hy with
      ⟨z, hz, hprojection⟩
    rw [mem_adjoinVector_iff] at hz
    rcases hz with ⟨w, hw, c, rfl⟩
    apply (mem_projectedLattice_iff q L x anisotropic y).2
    refine ⟨w, hw, ?_⟩
    have hline :
        q.projectionToOrthogonal x anisotropic (c • (a • x)) = 0 := by
      change q.projectionToOrthogonal x anisotropic
        ((c : K) • (a • x)) = 0
      rw [map_smul, map_smul]
      have hself : q.projectionToOrthogonal x anisotropic x = 0 := by
        apply Subtype.ext
        exact q.orthogonalProjection_self anisotropic
      rw [hself, smul_zero, smul_zero]
    have hsum :
        q.projectionToOrthogonal x anisotropic (w + c • (a • x)) =
          q.projectionToOrthogonal x anisotropic w := by
      rw [map_add, hline, add_zero]
    exact hsum.symm.trans hprojection
  · exact projectedLattice_mono q (le_adjoinVector L (a • x)) x anisotropic

end Lattice

end Bong
