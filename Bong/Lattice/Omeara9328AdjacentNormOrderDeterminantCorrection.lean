import Bong.Lattice.Omeara9328EqualOrderTwistAbsorption

/-!
# O'Meara 93:28, Step 6: adjacent normalized norm orders

This file treats the case `U₂ = U₁ + 1` after normalizing the first
Jordan scale.  Under the remaining Step-5 hypothesis `U₁ < e`, the first
weight has order `U₂`.  Perfectness of the residue field then shows that
every scalar in `a₁ O` belongs to the first norm group.  These facts
construct the determinant-correction data used by 93:13 and 93:19.
-/

namespace Bong

open Dyadic Module BONG.GoodBONG

namespace Lattice.JordanDecomposition

universe u v w

variable {K : Type u} [Field K] [CharZero K] [ValuativeRel K]
  [TopologicalSpace K] [DyadicContext K]
  [DyadicDiscriminantClassLaws K]
  {V : Type v} [AddCommGroup V] [Module K V]
  {W : Type w} [AddCommGroup W] [Module K W]
  {q : QuadraticSpace K V} {r : QuadraticSpace K W}
  {L : Lattice K V} {M : Lattice K W} {n : Nat}
  {J : JordanDecomposition q L (n + 2)}
  {H : JordanDecomposition r M (n + 2)}

namespace Omeara9328RankFourReductionSystem

variable (S : Omeara9328RankFourReductionSystem J H)

/-- In Step 6 the normalized first weight is generated by the normalized
second norm generator. -/
theorem adjacentNormOrder_firstWeightOrder_eq_second
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int)) :
    weightIdealOrder S.sourceFirstNormalized
        (S.sourceJordan.component 0).lattice =
      ordUnit K (S.secondNormalizedNormGeneratorWith A) := by
  let delta := S.secondNormalizedNormGeneratorWith A
  let a := S.firstNormGenerator
  have ha := S.firstNormGenerator_source
  have hnormLe : ordUnit K a ≤
      weightIdealOrder S.sourceFirstNormalized
        (S.sourceJordan.component 0).lattice :=
    normGeneratorOrder_le_weightIdealOrder a ha
  have hdeltaMem : (delta : K) ∈
      normGroupSet S.sourceFirstNormalized
        (S.sourceJordan.component 0).lattice :=
    S.secondNormalizedNormGeneratorWith_mem_sourceFirst A
  have hsumOdd : Odd (ordUnit K a + ordUnit K delta) := by
    refine ⟨ordUnit K a, ?_⟩
    dsimp only [a, delta] at hgap ⊢
    omega
  have hweightLe :
      weightIdealOrder S.sourceFirstNormalized
          (S.sourceJordan.component 0).lattice ≤ ordUnit K delta :=
    weightIdealOrder_le_ordUnit_of_mem_normGroupSet_of_odd
      a delta ha hdeltaMem hsumOdd
  rcases weightIdeal_eq_twoScale_or_odd a ha with hterminal | hodd
  · have hweightRamification :
        weightIdealOrder S.sourceFirstNormalized
            (S.sourceJordan.component 0).lattice =
          (ramificationIndex K : Int) := by
      let two : Kˣ := Units.mk0 (2 : K) (by norm_num)
      have htwoOrder : ordUnit K two =
          (ramificationIndex K : Int) := by
        apply WithTop.coe_injective
        rw [coe_ordUnit]
        exact (ramificationIndex_spec K).symm
      apply powerIdeal_order_eq_of_eq (K := K)
      calc
        powerIdeal (K := K)
            (weightIdealOrder S.sourceFirstNormalized
              (S.sourceJordan.component 0).lattice) =
            weightIdeal S.sourceFirstNormalized
              (S.sourceJordan.component 0).lattice :=
          (weightIdeal_eq_powerIdeal _ _).symm
        _ = twoScaleIdeal S.sourceFirstNormalized
              (S.sourceJordan.component 0).lattice := hterminal
        _ = principalIdeal (K := K) (2 : K) :=
          twoScaleIdeal_eq_principalIdeal_two_of_unimodular
            S.sourceFirstNormalized_unimodular
            (by rw [S.sourceFirstNormalized_finrank]; omega)
        _ = powerIdeal (K := K) (ordUnit K two) := by
          simpa only [two, Units.val_mk0] using
            (principalIdeal_eq_powerIdeal two)
        _ = powerIdeal (K := K) (ramificationIndex K : Int) := by
          rw [htwoOrder]
    dsimp only [a, delta] at hnormLe hweightLe hgap ⊢
    have hterminalOrder := hweightRamification
    omega
  · dsimp only [a, delta] at hnormLe hweightLe hodd hgap ⊢
    rcases hodd with ⟨k, hk⟩
    omega

/-- The intrinsic first fundamental ideal in the adjacent-order case is
the principal ideal generated by the product of the two normalized norm
generators chosen in the reduction system. -/
theorem adjacentNormOrder_firstFundamentalIdeal_eq_normProduct
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1) :
    S.sourceJordan.fundamentalIdeal 0 =
      principalIdeal (K := K)
        (((S.firstNormGenerator *
          S.secondNormalizedNormGeneratorWith A : Kˣ) : K)) := by
  have hcanonicalGap : ordUnit K S.secondNormalizedNormGenerator =
      ordUnit K S.firstNormGenerator + 1 := by
    rw [← S.secondNormalizedNormGeneratorWith_order_eq A]
    exact hgap
  have hintrinsicGap :=
    S.fundamentalNormOrder_eq_add_one_of_normalized_gap_one hcanonicalGap
  have hodd : Odd (S.sourceJordan.boundaryNormOrderSum 0) := by
    refine ⟨ordUnit K (S.sourceJordan.fundamentalNormGenerator 0), ?_⟩
    change ordUnit K (S.sourceJordan.fundamentalNormGenerator 0) +
        ordUnit K (S.sourceJordan.fundamentalNormGenerator 1) = _
    omega
  have hli : boundaryLeftIndex (0 : Fin (n + 1)) =
      (0 : Fin (n + 2)) := by
    ext
    rfl
  have hri : boundaryRightIndex (0 : Fin (n + 1)) =
      (1 : Fin (n + 2)) := by
    ext
    rfl
  calc
    S.sourceJordan.fundamentalIdeal 0 =
        principalIdeal (K := K)
          (((S.sourceJordan.scaleGenerator (boundaryLeftIndex 0))⁻¹ ^ 2 *
            S.sourceJordan.fundamentalNormGenerator (boundaryLeftIndex 0) *
            S.sourceJordan.fundamentalNormGenerator
              (boundaryRightIndex 0) : Kˣ) : K) :=
      S.sourceJordan.fundamentalIdeal_eq_principalIdeal_of_odd 0 hodd
    _ = principalIdeal (K := K)
        (((S.firstNormGenerator *
          S.secondNormalizedNormGeneratorWith A : Kˣ) : K)) := by
      apply (principalIdeal_eq_iff_ordUnit_eq _ _).2
      simp only [ordUnit_mul, ordUnit_pow, ordUnit_inv]
      rw [hli, hri]
      have hsOrder : ordUnit K (S.sourceJordan.scaleGenerator 0) =
          S.sourceJordan.fundamentalScaleOrder 0 := rfl
      rw [hsOrder, S.firstNormGenerator_order,
        S.secondNormalizedNormGeneratorWith_order_eq A,
        S.secondNormalizedNormGenerator_order]
      ring

/-- Witness form of the preceding product formula. -/
theorem exists_firstNormFactor_of_mem_firstFundamentalIdeal_adjacent
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    {z : K} (hz : z ∈ S.sourceJordan.fundamentalIdeal 0) :
    ∃ c : K, c ∈ principalIdeal (K := K)
        (S.firstNormGenerator : K) ∧
      z = (S.secondNormalizedNormGeneratorWith A : K) * c := by
  rw [S.adjacentNormOrder_firstFundamentalIdeal_eq_normProduct A hgap] at hz
  have hscalar :
      scalarIdeal (S.secondNormalizedNormGeneratorWith A : K)
          (principalIdeal (K := K) (S.firstNormGenerator : K)) =
        principalIdeal (K := K)
          ((S.firstNormGenerator *
            S.secondNormalizedNormGeneratorWith A : Kˣ) : K) := by
    simpa only [mul_comm] using
      (scalarIdeal_principalIdeal_units
        (S.secondNormalizedNormGeneratorWith A) S.firstNormGenerator)
  rw [← hscalar] at hz
  rcases hz with ⟨c, hc, hcz⟩
  exact ⟨c, hc, hcz.symm⟩

/-- Perfectness of the residue field upgrades the full principal norm
ideal `a₁ O` to represented values when the weight order is `U₁ + 1`.
This is the scalar step suppressed in O'Meara's phrase “proceed as in
Step 4.” -/
theorem firstNormPrincipalIdeal_subset_sourceFirstNormGroup_adjacent
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int)) :
    ∀ ⦃z : K⦄, z ∈ principalIdeal (K := K)
        (S.firstNormGenerator : K) →
      z ∈ normGroupSet S.sourceFirstNormalized
        (S.sourceJordan.component 0).lattice := by
  intro z hz
  let a := S.firstNormGenerator
  let delta := S.secondNormalizedNormGeneratorWith A
  have ha := S.firstNormGenerator_source
  have hweight := S.adjacentNormOrder_firstWeightOrder_eq_second
    A hgap hfirst
  by_cases hz0 : z = 0
  · subst z
    exact zero_mem_normGroupSet _ _
  let zu : Kˣ := Units.mk0 z hz0
  have horderTop := ord_le_of_mem_principalIdeal (Units.ne_zero a) hz
  have horder : ordUnit K a ≤ ordUnit K zu := by
    apply WithTop.coe_le_coe.mp
    simpa only [coe_ordUnit, zu, Units.val_mk0] using horderTop
  by_cases heven : Even (ordUnit K zu - ordUnit K a)
  · rcases exists_integral_square_approximation_of_even_order_difference
      a zu horder heven with ⟨c, hc⟩
    let y : K := z - (a : K) * (c : K) ^ 2
    have hy : y ∈ weightIdeal S.sourceFirstNormalized
        (S.sourceJordan.component 0).lattice := by
      rw [weightIdeal_eq_powerIdeal, mem_powerIdeal_iff, hweight]
      have hsucc := coe_int_add_one_le_of_lt hc
      have hdeltaLe : ordUnit K delta ≤ ordUnit K zu + 1 := by
        dsimp only [a, delta] at hgap horder ⊢
        omega
      exact (WithTop.coe_le_coe.mpr hdeltaLe).trans (by
        simpa only [y, zu, Units.val_mk0] using hsucc)
    rw [normGroupSet_eq_integralSquareCoset_weightIdeal a ha]
    exact ⟨c, y, hy, by dsimp only [y, a]; ring⟩
  · have hodd : Odd (ordUnit K zu - ordUnit K a) :=
      Int.not_even_iff_odd.mp heven
    rcases hodd with ⟨k, hk⟩
    have hdeltaLe : ordUnit K delta ≤ ordUnit K zu := by
      dsimp only [a, delta] at hgap horder hk ⊢
      omega
    apply weightIdeal_subset_normGroupSet a ha
    rw [weightIdeal_eq_powerIdeal]
    apply (mem_powerIdeal_iff _ _).2
    rw [hweight]
    simpa only [zu, Units.val_mk0, coe_ordUnit] using
      (WithTop.coe_le_coe.mpr hdeltaLe)

/-- The same principal ideal is represented by the normalized target
first component because the two first norm groups agree. -/
theorem firstNormPrincipalIdeal_subset_targetFirstNormGroup_adjacent
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int)) :
    ∀ ⦃z : K⦄, z ∈ principalIdeal (K := K)
        (S.firstNormGenerator : K) →
      z ∈ normGroupSet S.targetFirstNormalized
        (S.targetJordan.component 0).lattice := by
  intro z hz
  rw [← S.firstNormalized_normGroupSet_eq]
  exact S.firstNormPrincipalIdeal_subset_sourceFirstNormGroup_adjacent
    A hgap hfirst hz

/-- Determinant-error package for the adjacent-order case.  Its
coefficient lies in `a₁ O`, hence in both first norm groups; multiplication
by the square of the positive relative scale places it in `a₂ O`, which is
the sharp hypothesis of the subsequent 93:19 exchange. -/
noncomputable def adjacentNormOrderErrorData
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (z : K)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int))
    (hz : z ∈ S.sourceJordan.fundamentalIdeal 0) :
    S.EqualNormOrderErrorData z := by
  let delta := S.secondNormalizedNormGeneratorWith A
  let a := S.firstNormGenerator
  let hexists :=
    S.exists_firstNormFactor_of_mem_firstFundamentalIdeal_adjacent A hgap hz
  let coefficient : K := Classical.choose hexists
  have hcoefficientPrincipal : coefficient ∈
      principalIdeal (K := K) (a : K) :=
    (Classical.choose_spec hexists).1
  have hzEq : z = (delta : K) * coefficient :=
    (Classical.choose_spec hexists).2
  have hcoefficientSource : coefficient ∈
      normGroupSet S.sourceFirstNormalized
        (S.sourceJordan.component 0).lattice :=
    S.firstNormPrincipalIdeal_subset_sourceFirstNormGroup_adjacent
      A hgap hfirst hcoefficientPrincipal
  have hcoefficientTarget : coefficient ∈
      normGroupSet S.targetFirstNormalized
        (S.targetJordan.component 0).lattice :=
    S.firstNormPrincipalIdeal_subset_targetFirstNormGroup_adjacent
      A hgap hfirst hcoefficientPrincipal
  have haIntegral : (a : K) ∈ IntegerRing K :=
    S.firstNormGenerator_integral
  have haNonnegative : (0 : WithTop Int) ≤ ord K (a : K) := by
    exact (mem_integerRing_iff K).1 haIntegral
  have hcoefficientOrder := ord_le_of_mem_principalIdeal
    (Units.ne_zero a) hcoefficientPrincipal
  have hcoefficientIntegral : coefficient ∈ IntegerRing K := by
    rw [mem_integerRing_iff]
    exact haNonnegative.trans hcoefficientOrder
  have hdeltaIntegral : (delta : K) ∈ IntegerRing K := by
    rw [mem_integerRing_iff, Dyadic.IsIntegral, ← coe_ordUnit]
    have haOrderNonnegative : 0 ≤ ordUnit K a := by
      apply WithTop.coe_nonneg.mp
      simpa only [coe_ordUnit] using haNonnegative
    apply WithTop.coe_nonneg.mpr
    dsimp only [a, delta] at hgap haOrderNonnegative ⊢
    omega
  have hrelativeOrderPositive :
      0 < ordUnit K S.relativeSecondScale := by
    have hscaleStrict :
        S.sourceJordan.fundamentalScaleOrder 0 <
          S.sourceJordan.fundamentalScaleOrder 1 :=
      S.sourceJordan.scaleOrder_strict (by simp)
    have hrelative := S.relativeSecondScale_order
    omega
  have hgeneratorOrder : ord K (delta : K) ≤
      ord K ((a : K) * (S.relativeSecondScale : K) ^ 2) := by
    rw [ord_mul, ord_pow, ← coe_ordUnit, ← coe_ordUnit,
      ← coe_ordUnit]
    apply WithTop.coe_le_coe.mpr
    simp only [two_nsmul]
    dsimp only [a, delta] at hgap ⊢
    omega
  have hscaledOrder : ord K (delta : K) ≤
      ord K (coefficient * (S.relativeSecondScale : K) ^ 2) := by
    refine hgeneratorOrder.trans ?_
    simp only [ord_mul, ord_pow]
    simpa only [add_comm] using
      add_le_add_left hcoefficientOrder
        (2 • ord K (S.relativeSecondScale : K))
  have hscaledPrincipal :
      coefficient * (S.relativeSecondScale : K) ^ 2 ∈
        principalIdeal (K := K) (delta : K) :=
    mem_principalIdeal_of_ord_le (Units.ne_zero delta) hscaledOrder
  exact
    { secondGenerator := delta
      coefficient := coefficient
      error_eq := hzEq
      coefficient_integral := hcoefficientIntegral
      coefficient_mem_sourceFirst := hcoefficientSource
      coefficient_mem_targetFirst := hcoefficientTarget
      coefficient_mul_relativeScale_sq_mem_secondGeneratorIdeal :=
        hscaledPrincipal
      secondGenerator_integral := hdeltaIntegral
      secondGenerator_sourceSecond :=
        S.secondNormalizedNormGeneratorWith_source A
      secondGenerator_targetSecond :=
        S.secondNormalizedNormGeneratorWith_target A
      secondGenerator_mem_sourceFirst :=
        S.secondNormalizedNormGeneratorWith_mem_sourceFirst A
      secondGenerator_mem_targetFirst :=
        S.secondNormalizedNormGeneratorWith_mem_targetFirst A }

/-- The Step-6 error data specialized to the determinant congruence from
condition 93:28(i). -/
noncomputable def adjacentOrderErrorData
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int)) :
    S.EqualNormOrderErrorData
      (S.targetFirstCongruenceError A conditions).error :=
  S.adjacentNormOrderErrorData A
    (S.targetFirstCongruenceError A conditions).error hgap hfirst
    (S.targetFirstCongruenceError A conditions).error_mem

/-- The corrected normalized head in Step 6 has determinant class one. -/
theorem adjacentOrder_newHead_determinantClass_eq_one
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int)) :
    let D := S.adjacentOrderErrorData A conditions hgap hfirst
    determinantClass D.newHead D.newHeadLattice = 1 := by
  let C := S.targetFirstCongruenceError A conditions
  let D := S.adjacentOrderErrorData A conditions hgap hfirst
  change determinantClass D.newHead D.newHeadLattice = 1
  apply D.newHead_determinantClass_eq_one C.errorUnit
    C.errorUnit_coe C.errorUnit_isValuationUnit
  change unitSquareClass K
      (determinantUnit S.targetFirstNormalized
        (S.targetJordan.component 0).lattice) =
    unitSquareClass K C.errorUnit
  exact C.unitSquareClass_eq_errorUnit

/-- In the condition-(ii) branch of Step 6, the corrected head represents
a hyperbolic plane. -/
theorem adjacentOrderNewHeadRepresentsHyperbolicOfConditionII
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int))
    (htrigger : S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0)) :
    let D := S.adjacentOrderErrorData A conditions hgap hfirst
    D.newHead.Represents
      (QuadraticSpace.hyperbolicPlane (1 : Kˣ)) := by
  let D := S.adjacentOrderErrorData A conditions hgap hfirst
  change D.newHead.Represents
    (QuadraticSpace.hyperbolicPlane (1 : Kˣ))
  letI : Module.Finite K (S.sourceJordan.component 0).carrier :=
    (S.sourceJordan.component 0).lattice.moduleFinite
  letI : Module.Finite K (S.targetJordan.component 0).carrier :=
    (S.targetJordan.component 0).lattice.moduleFinite
  letI : Module.Finite K (D.headSplit.decomposition.component 1).carrier :=
    D.newHeadLattice.moduleFinite
  rcases S.normalizedConditionIIRepresentation A conditions htrigger with
    ⟨sourceInOldLine⟩
  rcases D.newPlaneRepresentsSecondGenerator with ⟨lineInNewPlane⟩
  let replaceLine :=
    (QuadraticSpace.Representation.refl S.targetFirstNormalized).orthogonalSum
      lineInNewPlane
  let sourceInOldNew := replaceLine.trans sourceInOldLine
  let swap : QuadraticSpace.Isometry
      (S.targetFirstNormalized.orthogonalSum D.exchangeSetup.newPlane)
      D.headAmbient :=
    (orthogonalProductSwap
      (q := S.targetFirstNormalized) (r := D.exchangeSetup.newPlane)
      (L := (S.targetJordan.component 0).lattice)
      (M := hyperbolicPlaneLattice (K := K))).toQuadraticSpaceIsometry
  let targetToSplit := swap.trans
    D.headSplit.displayedIsometry.toQuadraticSpaceIsometry
  have sourceInSplit :
      ((QuadraticSpace.hyperbolicPlane (1 : Kˣ)).orthogonalSum
        D.newHead).Represents S.sourceFirstNormalized :=
    ⟨targetToSplit.toRepresentation.trans sourceInOldNew⟩
  let hyperbolicToZero :=
    (scaledZeroOmearaPlaneLatticeIsometry (K := K) (1 : Kˣ)).symm
      |>.toQuadraticSpaceIsometry
  let pairToTower :=
    (hyperbolicToZero.orthogonalSum hyperbolicToZero).trans
      (twoZeroPlaneProductToTowerTwoSpaceIsometry (K := K))
  let sourceToPair := S.sourceFirstNormalizedHyperbolicTowerIsometry.trans
    pairToTower.symm
  have pairInSplit :
      ((QuadraticSpace.hyperbolicPlane (1 : Kˣ)).orthogonalSum
        D.newHead).Represents
      ((QuadraticSpace.hyperbolicPlane (1 : Kˣ)).orthogonalSum
        (QuadraticSpace.hyperbolicPlane (1 : Kˣ))) :=
    sourceInSplit.trans ⟨sourceToPair.symm.toRepresentation⟩
  exact QuadraticSpace.orthogonalSumLeftCancelRepresents
    (QuadraticSpace.hyperbolicPlane (1 : Kˣ))
    (QuadraticSpace.hyperbolicPlane (1 : Kˣ)) D.newHead pairInSplit

/-- The determinant-one rank-four criterion turns the preceding
representation into the standard hyperbolic tower. -/
theorem adjacentOrderNewHeadIsHyperbolicOfConditionII
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int))
    (htrigger : S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0)) :
    let D := S.adjacentOrderErrorData A conditions hgap hfirst
    D.newHead.IsIsometric
      (QuadraticSpace.scaledZeroOmearaTowerForm (1 : Kˣ) 2) := by
  let D := S.adjacentOrderErrorData A conditions hgap hfirst
  change D.newHead.IsIsometric
    (QuadraticSpace.scaledZeroOmearaTowerForm (1 : Kˣ) 2)
  letI : Module.Finite K (D.headSplit.decomposition.component 1).carrier :=
    D.newHeadLattice.moduleFinite
  have hpair :=
    QuadraticSpace.rankFour_isIsometric_hyperbolicPair_of_determinantClass_eq_one
      D.newHead D.newHeadLattice D.headSplit_complement_finrank
      (S.adjacentOrder_newHead_determinantClass_eq_one
        A conditions hgap hfirst)
      (S.adjacentOrderNewHeadRepresentsHyperbolicOfConditionII
        A conditions hgap hfirst htrigger)
  let hyperbolicToZero :=
    (scaledZeroOmearaPlaneLatticeIsometry (K := K) (1 : Kˣ)).symm
      |>.toQuadraticSpaceIsometry
  let pairToTower :=
    (hyperbolicToZero.orthogonalSum hyperbolicToZero).trans
      (twoZeroPlaneProductToTowerTwoSpaceIsometry (K := K))
  rcases hpair with ⟨f⟩
  exact ⟨f.trans pairToTower⟩

/-- Integral normalized-head alignment in the condition-(ii) branch. -/
noncomputable def adjacentOrderSourceToNewHeadIsometryOfConditionII
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int))
    (htrigger : S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0)) :
    let D := S.adjacentOrderErrorData A conditions hgap hfirst
    Isometry S.sourceFirstNormalized D.newHead
      (S.sourceJordan.component 0).lattice D.newHeadLattice := by
  let D := S.adjacentOrderErrorData A conditions hgap hfirst
  change Isometry S.sourceFirstNormalized D.newHead
    (S.sourceJordan.component 0).lattice D.newHeadLattice
  exact D.sourceToNewHeadIsometryOfHyperbolic
    (S.adjacentOrderNewHeadIsHyperbolicOfConditionII
      A conditions hgap hfirst htrigger)

/-- Install the adjacent-order coefficient shift as a saturated target
Jordan replacement. -/
noncomputable def adjacentOrderJordanReplacement
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int)) :
    Omeara9319JordanReplacement S.targetJordan :=
  (S.adjacentOrderErrorData A conditions hgap hfirst).jordanReplacement

/-- The displayed corrected head maps onto the first component of the
installed replacement. -/
noncomputable def adjacentOrderReplacementHeadIsometry
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int)) :
    let D := S.adjacentOrderErrorData A conditions hgap hfirst
    let R := S.adjacentOrderJordanReplacement A conditions hgap hfirst
    Isometry D.newHeadUnnormalized (R.target.component 0).space
      D.newHeadLattice (R.target.component 0).lattice := by
