      let N := D.newHeadOddDeterminantOneData hodd
        (S.adjacentOrder_newHead_determinantClass_eq_one
          A conditions C.hgap C.hfirst)
      IsIsometric D.newHead N.parameters.kData.space
        D.newHeadLattice N.parameters.kData.lattice) :
    Omeara9319JordanReplacement S.targetJordan := by
  let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
  let hdet := S.adjacentOrder_newHead_determinantClass_eq_one
    A conditions C.hgap C.hfirst
  let N := D.newHeadOddDeterminantOneData hodd hdet
  let B := S.adjacentOrderKRhoTwistAbsorptionData A conditions C.hgap
    C.hfirst hnontrigger hodd
  let f := S.adjacentOrderKFirstPairReplacementIsometry A conditions C
    hnontrigger hodd hk
  let hHeadMod := S.adjacentOrderKHeadUnnormalized_modular
    A conditions C hodd
  let hTailMod := S.adjacentOrderKTailUnnormalized_modular
    A conditions C hnontrigger hodd
  let hHeadScale := S.adjacentOrderKHeadUnnormalized_scaleIdeal
    A conditions C hodd
  let hTailScale := S.adjacentOrderKTailUnnormalized_scaleIdeal
    A conditions C hnontrigger hodd
  let hHeadNorm := S.adjacentOrderKHeadUnnormalized_normIdeal
    A conditions C hodd
  let hTailNorm := S.adjacentOrderKTailUnnormalized_normIdeal
    A conditions C hnontrigger hodd
  let T := S.targetJordan.replaceFirstPairOfIsometry f
    hHeadMod hTailMod hHeadScale hTailScale hHeadNorm hTailNorm
  exact
    { target := T
      fundamentalType :=
        S.targetJordan.replaceFirstPairOfIsometry_sameFundamentalType f
          hHeadMod hTailMod hHeadScale hTailScale hHeadNorm hTailNorm
      saturated :=
        S.targetJordan.replaceFirstPairOfIsometry_isSaturated f
          hHeadMod hTailMod hHeadScale hTailScale hHeadNorm hTailNorm
          S.targetJordan_isSaturated
          (S.targetFirst_normGroupSet_subset_adjacentOrderKHeadUnnormalized
            A conditions C hodd hk)
          (S.targetSecond_normGroupSet_subset_adjacentOrderKTailUnnormalized
            A conditions C hnontrigger hodd)
      laterPrefixIsometry := by
        intro k hk'
        exact S.targetJordan.toOrthogonalDecomposition
          |>.replacePair_first_prefixLatticeIsometry
            (S.targetJordan.firstPairDecompositionOfIsometry f) k hk' }

/-- The normalized source head, restored to the first Jordan scale, maps
integrally to the displayed untwisted head. -/
noncomputable def adjacentOrderKSourceToHeadUnnormalizedIsometry
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (C : S.AdjacentOrderCase A)
    (hodd : Odd S.firstNormWeightParity)
    (hk : let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
      let N := D.newHeadOddDeterminantOneData hodd
        (S.adjacentOrder_newHead_determinantClass_eq_one
          A conditions C.hgap C.hfirst)
      IsIsometric D.newHead N.parameters.kData.space
        D.newHeadLattice N.parameters.kData.lattice) :
    let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
    let N := D.newHeadOddDeterminantOneData hodd
      (S.adjacentOrder_newHead_determinantClass_eq_one
        A conditions C.hgap C.hfirst)
    Isometry (S.sourceJordan.component 0).space
      (S.adjacentOrderKHeadUnnormalized A conditions C hodd)
      (S.sourceJordan.component 0).lattice N.parameters.jData.lattice := by
  let normalized := S.adjacentOrderKSourceToJHeadIsometry
    A conditions C hodd hk
  let scaled := normalized.rescaleUnitBoth S.firstScale
  let undoSource := undoInverseRescaleLatticeIsometry
    (S.sourceJordan.component 0).space
    (S.sourceJordan.component 0).lattice S.firstScale
  exact undoSource.symm.trans scaled

set_option maxHeartbeats 3000000 in
/-- The displayed untwisted head maps onto the actual first component of
the installed Step-6 Jordan replacement. -/
noncomputable def adjacentOrderKReplacementHeadIsometry
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (C : S.AdjacentOrderCase A)
    (hnontrigger : ¬ S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0))
    (hodd : Odd S.firstNormWeightParity)
    (hk : let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
      let N := D.newHeadOddDeterminantOneData hodd
        (S.adjacentOrder_newHead_determinantClass_eq_one
          A conditions C.hgap C.hfirst)
      IsIsometric D.newHead N.parameters.kData.space
        D.newHeadLattice N.parameters.kData.lattice) :
    let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
    let N := D.newHeadOddDeterminantOneData hodd
      (S.adjacentOrder_newHead_determinantClass_eq_one
        A conditions C.hgap C.hfirst)
    let R := S.adjacentOrderKJordanReplacement A conditions C
      hnontrigger hodd hk
    Isometry (S.adjacentOrderKHeadUnnormalized A conditions C hodd)
      (R.target.component 0).space N.parameters.jData.lattice
      (R.target.component 0).lattice := by
  let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
  let hdet := S.adjacentOrder_newHead_determinantClass_eq_one
    A conditions C.hgap C.hfirst
  let N := D.newHeadOddDeterminantOneData hodd hdet
  let B := S.adjacentOrderKRhoTwistAbsorptionData A conditions C.hgap
    C.hfirst hnontrigger hodd
  let f := S.adjacentOrderKFirstPairReplacementIsometry A conditions C
    hnontrigger hodd hk
  let hHeadMod := S.adjacentOrderKHeadUnnormalized_modular
    A conditions C hodd
  let hTailMod := S.adjacentOrderKTailUnnormalized_modular
    A conditions C hnontrigger hodd
  let hHeadScale := S.adjacentOrderKHeadUnnormalized_scaleIdeal
    A conditions C hodd
  let hTailScale := S.adjacentOrderKTailUnnormalized_scaleIdeal
    A conditions C hnontrigger hodd
  let hHeadNorm := S.adjacentOrderKHeadUnnormalized_normIdeal
    A conditions C hodd
  let hTailNorm := S.adjacentOrderKTailUnnormalized_normIdeal
    A conditions C hnontrigger hodd
  let R := S.adjacentOrderKJordanReplacement A conditions C
    hnontrigger hodd hk
  change Isometry (S.adjacentOrderKHeadUnnormalized A conditions C hodd)
    (R.target.component 0).space N.parameters.jData.lattice
    (R.target.component 0).lattice
  rw [show R.target = S.targetJordan.replaceFirstPairOfIsometry f
      hHeadMod hTailMod hHeadScale hTailScale hHeadNorm hTailNorm by rfl]
  exact S.targetJordan.replaceFirstPairOfIsometry_leftIsometry f
    hHeadMod hTailMod hHeadScale hTailScale hHeadNorm hTailNorm

/-- Source head aligned with the actual first component of the installed
nontrigger replacement. -/
noncomputable def adjacentOrderKSourceToReplacementHeadIsometry
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (C : S.AdjacentOrderCase A)
    (hnontrigger : ¬ S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0))
    (hodd : Odd S.firstNormWeightParity)
    (hk : let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
      let N := D.newHeadOddDeterminantOneData hodd
        (S.adjacentOrder_newHead_determinantClass_eq_one
          A conditions C.hgap C.hfirst)
      IsIsometric D.newHead N.parameters.kData.space
        D.newHeadLattice N.parameters.kData.lattice) :
    let R := S.adjacentOrderKJordanReplacement A conditions C
      hnontrigger hodd hk
    Isometry (S.sourceJordan.component 0).space (R.target.component 0).space
      (S.sourceJordan.component 0).lattice (R.target.component 0).lattice :=
  (S.adjacentOrderKSourceToHeadUnnormalizedIsometry
    A conditions C hodd hk).trans
      (S.adjacentOrderKReplacementHeadIsometry A conditions C
        hnontrigger hodd hk)

/-- Complete Step-6 head-alignment object in the nontrigger twisted-model
branch. -/
noncomputable def adjacentOrderHeadAlignedReplacementOfNontriggerK
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (C : S.AdjacentOrderCase A)
    (hnontrigger : ¬ S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0))
    (hodd : Odd S.firstNormWeightParity)
    (hk : let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
      let N := D.newHeadOddDeterminantOneData hodd
        (S.adjacentOrder_newHead_determinantClass_eq_one
          A conditions C.hgap C.hfirst)
      IsIsometric D.newHead N.parameters.kData.space
        D.newHeadLattice N.parameters.kData.lattice) :
    Omeara9328HeadAlignedReplacement S.sourceJordan S.targetJordan A := by
  let R := S.adjacentOrderKJordanReplacement A conditions C
    hnontrigger hodd hk
  let head := S.adjacentOrderKSourceToReplacementHeadIsometry
    A conditions C hnontrigger hodd hk
  let boundary := omeara9328BoundaryZeroConditionsWith_of_headIsometry
    S.sourceJordan R.target A head
  exact R.headAlignedReplacement S.residualFundamentalType A conditions
    boundary head

/-- Nontrigger even-parity subcase of O'Meara 93:28, Step 6. -/
noncomputable def adjacentOrderHeadAlignedReplacementOfNontriggerEven
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (C : S.AdjacentOrderCase A)
    (heven : Even S.firstNormWeightParity) :
    Omeara9328HeadAlignedReplacement S.sourceJordan S.targetJordan A := by
  let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
  let hdet := S.adjacentOrder_newHead_determinantClass_eq_one
    A conditions C.hgap C.hfirst
  exact S.adjacentOrderHeadAlignedReplacementOfNormalizedHead
    A conditions C.hgap C.hfirst (D.sourceToNewHeadEvenIsometry heven hdet)

/-- Nontrigger odd-parity subcase when 93:18(vi) selects the untwisted
`J`-model directly. -/
noncomputable def adjacentOrderHeadAlignedReplacementOfNontriggerJ
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (C : S.AdjacentOrderCase A)
    (hodd : Odd S.firstNormWeightParity)
    (hj : let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
      let N := D.newHeadOddDeterminantOneData hodd
        (S.adjacentOrder_newHead_determinantClass_eq_one
          A conditions C.hgap C.hfirst)
      IsIsometric D.newHead N.parameters.jData.space
        D.newHeadLattice N.parameters.jData.lattice) :
    Omeara9328HeadAlignedReplacement S.sourceJordan S.targetJordan A := by
  let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
  let hdet := S.adjacentOrder_newHead_determinantClass_eq_one
    A conditions C.hgap C.hfirst
  let N := D.newHeadOddDeterminantOneData hodd hdet
  let jIso := Classical.choice hj
  have htower : D.newHead.IsIsometric
      (QuadraticSpace.scaledZeroOmearaTowerForm (1 : Kˣ) 2) :=
    ⟨jIso.toQuadraticSpaceIsometry.trans
      (N.parameters.jSpaceToHyperbolicTowerIsometry N.alpha_zero)⟩
  exact S.adjacentOrderHeadAlignedReplacementOfNormalizedHead
    A conditions C.hgap C.hfirst
      (D.sourceToNewHeadIsometryOfHyperbolic htower)

/-- The non-condition-(ii) half of Step 6: even heads are hyperbolic by
93:18(ii), while odd heads are the two alternatives of 93:18(vi), with the
`K` alternative converted to `J` by two explicit 93:19 shifts. -/
noncomputable def adjacentOrderHeadAlignedReplacementOfNontrigger
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (C : S.AdjacentOrderCase A)
    (hnontrigger : ¬ S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0)) :
    Omeara9328HeadAlignedReplacement S.sourceJordan S.targetJordan A := by
  by_cases hodd : Odd S.firstNormWeightParity
  · let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
    let hdet := S.adjacentOrder_newHead_determinantClass_eq_one
      A conditions C.hgap C.hfirst
    let N := D.newHeadOddDeterminantOneData hodd hdet
    by_cases hj : IsIsometric D.newHead N.parameters.jData.space
        D.newHeadLattice N.parameters.jData.lattice
    · exact S.adjacentOrderHeadAlignedReplacementOfNontriggerJ
        A conditions C hodd hj
    · have hk := N.isometric_j_or_k.resolve_left hj
      exact S.adjacentOrderHeadAlignedReplacementOfNontriggerK
        A conditions C hnontrigger hodd hk
  · have heven : Even S.firstNormWeightParity :=
      Int.not_odd_iff_even.mp hodd
    exact S.adjacentOrderHeadAlignedReplacementOfNontriggerEven
      A conditions C heven

/-- Complete O'Meara 93:28 Step 6 in the adjacent normalized norm-order
case, with no residual local classification law. -/
noncomputable def adjacentOrderHeadAlignedReplacement
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int)) :
    Omeara9328HeadAlignedReplacement S.sourceJordan S.targetJordan A := by
  let C : S.AdjacentOrderCase A := ⟨hgap, hfirst⟩
  by_cases htrigger : S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A (boundaryRightIndex 0)
  · exact S.adjacentOrderHeadAlignedReplacementOfConditionII
      A conditions C.hgap C.hfirst htrigger
  · exact S.adjacentOrderHeadAlignedReplacementOfNontrigger
      A conditions C htrigger

end Omeara9328RankFourReductionSystem

