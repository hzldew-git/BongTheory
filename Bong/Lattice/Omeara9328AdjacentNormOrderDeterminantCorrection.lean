      S.sourceSecondNormalized_weightIdealOrder_eq_fundamental]
    dsimp only [x]
    rw [Lattice.scratch_neg_omearaRhoTwistUnit_order,
      N.parameters_b, ordUnit_uniformizerPowerUnit,
