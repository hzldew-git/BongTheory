      (S.targetFirstNormalized.orthogonalSum S.targetSecondNormalized)
      (N.parameters.jData.space.orthogonalSum B.tailSpace)
      (product (S.targetJordan.component 0).lattice
        (S.targetJordan.component 1).lattice)
