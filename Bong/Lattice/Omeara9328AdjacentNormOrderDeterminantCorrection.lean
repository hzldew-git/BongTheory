/-- Negating the strict containment in condition 93:28(ii) in the
adjacent-order case gives the weak weight inequality needed to absorb
both rho-twists into the second component.  This includes the equality
case at the boundary of the condition. -/
theorem adjacentOrder_nontrigger_weight_order
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hnontrigger : ¬ S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0)) :
    S.sourceJordan.fundamentalWeightOrder 1 ≤
      2 * (ramificationIndex K : Int) +
        S.sourceJordan.fundamentalScaleOrder 0 -
          ordUnit K S.firstNormGenerator := by
  rw [S.adjacentNormOrder_firstFundamentalIdeal_eq_normProduct A hgap]
    at hnontrigger
  unfold fourNormOverWeightIdealWith at hnontrigger
  rw [show boundaryRightIndex (0 : Fin (n + 1)) =
      (1 : Fin (n + 2)) by ext; rfl,
    principalIdeal_eq_powerIdeal, powerIdeal_lt_iff] at hnontrigger
  simp only [ordUnit_mul] at hnontrigger
  have hdeltaOrder :
      ordUnit K (S.secondNormalizedNormGeneratorWith A) =
        -ordUnit K (J.scaleGenerator 0) + ordUnit K (A.value 1) := by
    unfold secondNormalizedNormGeneratorWith
    simp only [ordUnit_mul, ordUnit_inv,
      Omeara9328RankFourReductionSystem.firstScale,
      S.sourceJordan_scaleGenerator]
  have hscale : S.sourceJordan.fundamentalScaleOrder 0 =
      ordUnit K (J.scaleGenerator 0) := by
    unfold fundamentalScaleOrder
    rw [S.sourceJordan_scaleGenerator]
  rw [hscale]
  omega

/-- A scalar whose order differs evenly from a norm generator and whose
first possible approximation error already lies in the weight ideal is
represented.  This is the perfect-residue-field argument used at the
equality boundary in O'Meara 93:28, Step 6. -/
theorem mem_normGroupSet_of_even_order_difference_of_weight_order_le_succ
    {X : Type*} [AddCommGroup X] [Module K X]
    {p : QuadraticSpace K X} {N : Lattice K X}
    (a z : Kˣ) (ha : IsNormGeneratorValue p N a)
    (hle : ordUnit K a ≤ ordUnit K z)
    (heven : Even (ordUnit K z - ordUnit K a))
    (hweight : weightIdealOrder p N ≤ ordUnit K z + 1) :
    (z : K) ∈ normGroupSet p N := by
  rw [normGroupSet_eq_integralSquareCoset_weightIdeal a ha]
  rcases exists_integral_square_approximation_of_even_order_difference
      a z hle heven with ⟨c, hc⟩
  let y : K := (z : K) - (a : K) * (c : K) ^ 2
  refine ⟨c, y, ?_, ?_⟩
  · rw [weightIdeal_eq_powerIdeal, mem_powerIdeal_iff]
    have hsucc := coe_int_add_one_le_of_lt hc
    exact (WithTop.coe_le_coe.mpr hweight).trans (by
      simpa only [y] using hsucc)
  · dsimp only [y]
    ring

