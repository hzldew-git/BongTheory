/-- The twice-shifted tail still has the coherent second norm generator.
This uses the sharp complement-containment theorem for each 93:19
exchange, rather than the false equal-ideal shortcut unavailable in
adjacent order. -/
theorem adjacentOrderKTail_normGenerator
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
      ordUnit K S.firstNormGenerator + 1)
    (hfirst : ordUnit K S.firstNormGenerator <
      (ramificationIndex K : Int))
    (hnontrigger : ¬ S.sourceJordan.fundamentalIdeal 0 <
      S.sourceJordan.fourNormOverWeightIdealWith A
        (boundaryRightIndex 0))
    (hodd : Odd S.firstNormWeightParity) :
    let D := S.adjacentOrderErrorData A conditions hgap hfirst
    let B := S.adjacentOrderKRhoTwistAbsorptionData A conditions hgap
      hfirst hnontrigger hodd
    IsNormGeneratorValue B.tailSpace B.tailLattice D.secondGenerator := by
  let D := S.adjacentOrderErrorData A conditions hgap hfirst
  let hdet := S.adjacentOrder_newHead_determinantClass_eq_one
    A conditions hgap hfirst
  let N := D.newHeadOddDeterminantOneData hodd hdet
  let B := S.adjacentOrderKRhoTwistAbsorptionData A conditions hgap
    hfirst hnontrigger hodd
  have hweight := S.adjacentNormOrder_firstWeightOrder_eq_second
    A hgap hfirst
  have hbOrder : ordUnit K N.parameters.b = ordUnit K D.secondGenerator := by
    change ordUnit K N.parameters.b =
      ordUnit K (S.secondNormalizedNormGeneratorWith A)
    rw [N.parameters_b, ordUnit_uniformizerPowerUnit,
      ← D.newHead_weightIdealOrder_eq_source, hweight]
  have hbIdeal : principalIdeal (K := K) (N.parameters.b : K) =
      principalIdeal (K := K) (D.secondGenerator : K) :=
    (principalIdeal_eq_iff_ordUnit_eq _ _).2 hbOrder
  have hrightTail : N.parameters.kData.rightTail ∈
      principalIdeal (K := K) (D.secondGenerator : K) := by
    rw [← hbIdeal]
    exact N.parameters.kData.rightTailIdeal_le_bIdeal
      (generator_mem_principalIdeal N.parameters.kData.rightTail)
  have hleftTail : N.parameters.kData.leftTail ∈
      principalIdeal (K := K) (D.secondGenerator : K) := by
    rw [← hbIdeal]
    exact N.parameters.kData.leftTailIdeal_le_bIdeal
      (generator_mem_principalIdeal N.parameters.kData.leftTail)
  have hsIntegral : (S.relativeSecondScale : K) ^ 2 ∈ IntegerRing K :=
    (IntegerRing K).toSubring.pow_mem
      ((mem_integerRing_iff K).2
        (le_of_lt S.relativeSecondScale_isInMaximalIdeal)) 2
  have hrightScaleSq : (N.parameters.b : K) *
      (S.relativeSecondScale : K) ^ 2 ∈
        principalIdeal (K := K) (D.secondGenerator : K) := by
    have hbMem : (N.parameters.b : K) ∈
        principalIdeal (K := K) (D.secondGenerator : K) := by
      rw [← hbIdeal]
      exact generator_mem_principalIdeal (N.parameters.b : K)
    let c : IntegerRing K :=
      ⟨(S.relativeSecondScale : K) ^ 2, hsIntegral⟩
    have h := (principalIdeal (K := K)
      (D.secondGenerator : K)).smul_mem c hbMem
    change (S.relativeSecondScale : K) ^ 2 * (N.parameters.b : K) ∈
      principalIdeal (K := K) (D.secondGenerator : K) at h
    simpa only [mul_comm] using h
  have hrelativePositive : 0 < ordUnit K S.relativeSecondScale := by
    have hscaleStrict :
        S.sourceJordan.fundamentalScaleOrder 0 <
          S.sourceJordan.fundamentalScaleOrder 1 :=
      S.sourceJordan.scaleOrder_strict (by simp)
    have hrelative := S.relativeSecondScale_order
    omega
  have hleftScaleSq : (N.parameters.a : K) *
      (S.relativeSecondScale : K) ^ 2 ∈
        principalIdeal (K := K) (D.secondGenerator : K) := by
    apply mem_principalIdeal_of_ord_le (Units.ne_zero D.secondGenerator)
    rw [ord_mul, ord_pow, ← coe_ordUnit, ← coe_ordUnit,
      ← coe_ordUnit]
    apply WithTop.coe_le_coe.mpr
    simp only [two_nsmul]
    rw [N.parameters_a]
    change ordUnit K (S.secondNormalizedNormGeneratorWith A) ≤ _
    omega
  change IsNormGeneratorValue B.tailSpace B.tailLattice D.secondGenerator
  exact B.tailNormGenerator_of D.secondGenerator
    D.tailShift_complement_secondNormGenerator hrightTail hrightScaleSq
    hleftTail hleftScaleSq

/-- The two numerical hypotheses of O'Meara 93:28, Step 6, bundled so the
installation of the corrected first pair does not repeatedly elaborate the
same dependent equalities. -/
structure AdjacentOrderCase
    (A : FundamentalNormGeneratorChoice S.sourceJordan) : Prop where
  hgap : ordUnit K (S.secondNormalizedNormGeneratorWith A) =
    ordUnit K S.firstNormGenerator + 1
  hfirst : ordUnit K S.firstNormGenerator <
    (ramificationIndex K : Int)

/-- Although the corrected head is the twisted `K`-model, the untwisted
`J`-model has exactly the source norm group.  Unimodular classification
therefore gives an integral source-to-`J` isometry. -/
noncomputable def adjacentOrderKSourceToJHeadIsometry
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
    (conditions : S.sourceJordan.Omeara9328ConditionsWith
      S.targetJordan A)
    (C : S.AdjacentOrderCase A)
    (hodd : Odd S.firstNormWeightParity)
    (hk : let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
      let N := D.newHeadOddDeterminantOneData hodd
        (S.adjacentOrder_newHead_determinantClass_eq_one
          A conditions C.hgap C.hfirst)
      IsIsometric D.newHead N.parameters.kData.space
        D.newHeadLattice N.parameters.kData.lattice) :
    let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
    let N := D.newHeadOddDeterminantOneData hodd
      (S.adjacentOrder_newHead_determinantClass_eq_one
        A conditions C.hgap C.hfirst)
    Isometry S.sourceFirstNormalized N.parameters.jData.space
      (S.sourceJordan.component 0).lattice
      N.parameters.jData.lattice := by
  let D := S.adjacentOrderErrorData A conditions C.hgap C.hfirst
  let hdet := S.adjacentOrder_newHead_determinantClass_eq_one
    A conditions C.hgap C.hfirst
  let N := D.newHeadOddDeterminantOneData hodd hdet
  change Isometry S.sourceFirstNormalized N.parameters.jData.space
    (S.sourceJordan.component 0).lattice N.parameters.jData.lattice
  let kIso := Classical.choice hk
  have hgroup :
      normGroupSet S.sourceFirstNormalized
          (S.sourceJordan.component 0).lattice =
        normGroupSet N.parameters.jData.space
          N.parameters.jData.lattice := by
    calc
      normGroupSet S.sourceFirstNormalized
          (S.sourceJordan.component 0).lattice =
          normGroupSet D.newHead D.newHeadLattice :=
        D.newHead_normGroupSet_eq_source
      _ = normGroupSet N.parameters.kData.space
          N.parameters.kData.lattice :=
        normGroupSet_eq_of_latticeIsometry kIso.symm
      _ = integralSquareCoset (N.parameters.a : K)
          (principalIdeal (K := K) (N.parameters.b : K)) :=
        N.parameters.k_normGroupSet_eq
      _ = normGroupSet N.parameters.jData.space
          N.parameters.jData.lattice :=
        N.parameters.j_normGroupSet_eq.symm
  let fieldIso := S.sourceFirstNormalizedHyperbolicTowerIsometry.trans
    (N.parameters.jSpaceToHyperbolicTowerIsometry N.alpha_zero).symm
  exact latticeIsometryToUnimodularModel
    S.sourceFirstNormalized_unimodular N.parameters.jData.isModular
    fieldIso hgroup

/-- The untwisted Step-6 head restored to the original first Jordan scale. -/
noncomputable abbrev adjacentOrderKHeadUnnormalized
    (A : FundamentalNormGeneratorChoice S.sourceJordan)
