/-- The inserted global vector family has exactly the target diagonal
coefficient at every position. -/
theorem quadratic_lemma714TypeIITargetVector
    [DyadicDiscriminantClassLaws K]
    (b : GoodBONG q L (n + 3))
    (S : TwoBlockSplitWitness b.toBONG 2 (lemma714TypeIIGeometry_two_le_rank n))
    (s : Nat) (hsTwo : 2 ≤ s) (hsCurrent : s < n + 3)
    (ε η : Kˣ)
    (block : GoodBONG
      ((q.restrict S.left.carrier S.left.nondegenerate).orthogonalSum
        ((q.restrict S.right.carrier S.right.nondegenerate).restrict
          (b.lemma714TypeIILineSegment S s hsTwo hsCurrent).carrier
          (b.lemma714TypeIILineSegment S s hsTwo hsCurrent).nondegenerate))
      (Lattice.product
        (Lattice.rescale (uniformizerUnit K) S.left.lattice)
        (b.lemma714TypeIILineSegment S s hsTwo hsCurrent).lattice) 3)
    (hblockValues : ∀ i, block.valueUnit i =
      lemma712TargetValues (b.valueUnit ⟨s, hsCurrent⟩) ε η i)
    (i : Fin (n + 3)) :
    ((q.restrict S.right.carrier S.right.nondegenerate).orthogonalSum
        (q.restrict S.left.carrier S.left.nondegenerate)).quadratic
      (lemma714TypeIITargetVector b S s hsTwo hsCurrent block i) =
    (lemma714TypeIITargetValues b s hsTwo hsCurrent ε η i : K) := by
  by_cases hprefix : i.val < s - 2
  · rw [lemma714TypeIITargetVector_prefix b S s hsTwo hsCurrent block i hprefix,
      lemma714TypeIITargetValues_prefix b s hsTwo hsCurrent ε η i hprefix,
      QuadraticSpace.orthogonalSum_quadratic_apply]
    rw [(q.restrict S.left.carrier S.left.nondegenerate).quadratic_zero,
      add_zero, (b.lemma714Tail S).toBONG.quadratic_ambientVector,
      ← BONG.coe_valueUnit]
    change ((b.lemma714Tail S).valueUnit ⟨i.val, by omega⟩ : K) =
      (b.valueUnit ⟨i.val + 2, by omega⟩ : K)
    rw [b.lemma714Tail_valueUnit S]
    congr 2
    apply Fin.ext
    change 2 + i.val = i.val + 2
    omega
  by_cases hzero : i.val = s - 2
  · have hi : i = (⟨s - 2, by omega⟩ : Fin (n + 3)) := Fin.ext hzero
    rw [hi]
    rw [lemma714TypeIITargetVector_zero,
      lemma714TypeIITargetValues_zero,
      quadratic_lemma714TypeIIEmbedBlockVector,
      block.toBONG.quadratic_ambientVector]
    change (block.valueUnit 0 : K) =
      (lemma712TargetValues (b.valueUnit ⟨s, hsCurrent⟩) ε η 0 : K)
    rw [hblockValues]
  by_cases hone : i.val = s - 1
  · have hi : i = (⟨s - 1, by omega⟩ : Fin (n + 3)) := Fin.ext hone
    rw [hi]
    rw [lemma714TypeIITargetVector_one,
      lemma714TypeIITargetValues_one,
      quadratic_lemma714TypeIIEmbedBlockVector,
      block.toBONG.quadratic_ambientVector]
    change (block.valueUnit 1 : K) =
      (lemma712TargetValues (b.valueUnit ⟨s, hsCurrent⟩) ε η 1 : K)
    rw [hblockValues]
  by_cases htwo : i.val = s
  · have hi : i = (⟨s, hsCurrent⟩ : Fin (n + 3)) := Fin.ext htwo
    rw [hi]
    rw [lemma714TypeIITargetVector_two,
      lemma714TypeIITargetValues_two,
      quadratic_lemma714TypeIIEmbedBlockVector,
      block.toBONG.quadratic_ambientVector]
    change (block.valueUnit 2 : K) =
      (lemma712TargetValues (b.valueUnit ⟨s, hsCurrent⟩) ε η 2 : K)
    rw [hblockValues]
  · have hsuffix : s < i.val := by omega
    rw [lemma714TypeIITargetVector_suffix b S s hsTwo hsCurrent block i hsuffix,
      lemma714TypeIITargetValues_suffix b s hsTwo hsCurrent ε η i hsuffix,
      QuadraticSpace.orthogonalSum_quadratic_apply]
    rw [(q.restrict S.left.carrier S.left.nondegenerate).quadratic_zero,
      add_zero, (b.lemma714Tail S).toBONG.quadratic_ambientVector,
      ← BONG.coe_valueUnit]
    change ((b.lemma714Tail S).valueUnit ⟨i.val - 2, by omega⟩ : K) =
      (b.valueUnit i : K)
    rw [b.lemma714Tail_valueUnit S]
    congr 2
    apply Fin.ext
    change 2 + (i.val - 2) = i.val
    omega

/-- The full inserted vector family is a basis of `L_3 perp pi J`. -/
noncomputable def lemma714TypeIITargetBasis
    [DyadicDiscriminantClassLaws K]
    (b : GoodBONG q L (n + 3))
    (S : TwoBlockSplitWitness b.toBONG 2 (lemma714TypeIIGeometry_two_le_rank n))
    (s : Nat) (hsTwo : 2 ≤ s) (hsCurrent : s < n + 3)
    (ε η : Kˣ)
    (block : GoodBONG
      ((q.restrict S.left.carrier S.left.nondegenerate).orthogonalSum
        ((q.restrict S.right.carrier S.right.nondegenerate).restrict
          (b.lemma714TypeIILineSegment S s hsTwo hsCurrent).carrier
          (b.lemma714TypeIILineSegment S s hsTwo hsCurrent).nondegenerate))
      (Lattice.product
        (Lattice.rescale (uniformizerUnit K) S.left.lattice)
        (b.lemma714TypeIILineSegment S s hsTwo hsCurrent).lattice) 3)
    (hblockValues : ∀ i, block.valueUnit i =
      lemma712TargetValues (b.valueUnit ⟨s, hsCurrent⟩) ε η i) :
    Basis (Fin (n + 3)) K (S.right.carrier × S.left.carrier) := by
  letI : FiniteDimensional K S.right.carrier :=
    (b.lemma714Tail S).toBONG.basis.finiteDimensional_of_finite
  letI : FiniteDimensional K S.left.carrier :=
    (b.lemma714InitialBinary S).toBONG.basis.finiteDimensional_of_finite
  let family := lemma714TypeIITargetVector b S s hsTwo hsCurrent block
  have horthogonal :=
    b.lemma714TypeIITargetVector_iIsOrtho S s hsTwo hsCurrent block
  have hself : ∀ i,
      ((q.restrict S.right.carrier S.right.nondegenerate).orthogonalSum
        (q.restrict S.left.carrier S.left.nondegenerate)).bilin
          (family i) (family i) ≠ 0 := by
    intro i
    change ((q.restrict S.right.carrier S.right.nondegenerate).orthogonalSum
      (q.restrict S.left.carrier S.left.nondegenerate)).quadratic
        (lemma714TypeIITargetVector b S s hsTwo hsCurrent block i) ≠ 0
    rw [b.quadratic_lemma714TypeIITargetVector S s hsTwo hsCurrent ε η
      block hblockValues i]
    exact Units.ne_zero _
  have hlinear : LinearIndependent K family :=
    LinearMap.BilinForm.linearIndependent_of_iIsOrtho horthogonal hself
  have hcard : Fintype.card (Fin (n + 3)) =
      Module.finrank K (S.right.carrier × S.left.carrier) := by
    rw [Fintype.card_fin, Module.finrank_prod]
    have htail := (b.lemma714Tail S).toBONG.length_eq_finrank
    have hleft := (b.lemma714InitialBinary S).toBONG.length_eq_finrank
    omega
  exact basisOfLinearIndependentOfCardEqFinrank' family hlinear hcard

@[simp]
theorem lemma714TypeIITargetBasis_apply
    [DyadicDiscriminantClassLaws K]
    (b : GoodBONG q L (n + 3))
    (S : TwoBlockSplitWitness b.toBONG 2 (lemma714TypeIIGeometry_two_le_rank n))
    (s : Nat) (hsTwo : 2 ≤ s) (hsCurrent : s < n + 3)
    (ε η : Kˣ)
    (block : GoodBONG
      ((q.restrict S.left.carrier S.left.nondegenerate).orthogonalSum
