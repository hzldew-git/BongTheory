/-- Beli's numerical criterion realizes the explicit global orthogonal basis
as a good BONG.  The result still carries its initially constructed lattice;
Lemma 7.10 will identify that lattice with the concrete product. -/
theorem exists_lemma714_typeII_targetGoodBONG_of_localBlock
    [laws : DyadicDiscriminantClassLaws K]
    [QuadraticDefectLaws K]
    [BeliLemma43ConstructionLaws.{u, v} K]
    [Beli2006SectionTwoLaws.{u, v} K]
    (b : GoodBONG q L (n + 3)) (R : Int) (s : Nat)
    (D : Lemma714StoppingData b R s)
    (hthird : R + 1 ≤ b.order ⟨2, by omega⟩)
    (hsCurrent : s < n + 3)
    (hcurrent : b.order ⟨s, hsCurrent⟩ = R + 1)
    (ε η : Kˣ)
    (hεUnit : IsValuationUnit K (ε : K))
    (hηUnit : IsValuationUnit K (η : K))
    (hηDefect : defectOrder (K := K) η =
      (((2 * (ramificationIndex K : ℚ) - 1 : ℚ)) : WithTop ℚ))
    (S : TwoBlockSplitWitness b.toBONG 2 (lemma714TypeIIGeometry_two_le_rank n))
    (block : GoodBONG
      ((q.restrict S.left.carrier S.left.nondegenerate).orthogonalSum
        ((q.restrict S.right.carrier S.right.nondegenerate).restrict
          (b.lemma714TypeIILineSegment S s D.two_le hsCurrent).carrier
          (b.lemma714TypeIILineSegment S s D.two_le hsCurrent).nondegenerate))
      (Lattice.product
        (Lattice.rescale (uniformizerUnit K) S.left.lattice)
        (b.lemma714TypeIILineSegment S s D.two_le hsCurrent).lattice) 3)
    (hblockValues : ∀ i, block.valueUnit i =
      lemma712TargetValues (b.valueUnit ⟨s, hsCurrent⟩) ε η i) :
    ∃ (N : Lattice K (S.right.carrier × S.left.carrier))
        (target : GoodBONG
          ((q.restrict S.right.carrier S.right.nondegenerate).orthogonalSum
            (q.restrict S.left.carrier S.left.nondegenerate)) N (n + 3)),
      (∀ i, target.valueUnit i =
        lemma714TypeIITargetValues b s D.two_le hsCurrent ε η i) ∧
      ∀ i, target.toBONG.ambientVector i =
        lemma714TypeIITargetVector b S s D.two_le hsCurrent block i := by
  let X := b.lemma714TypeIIOrthogonalBasisData S s D.two_le hsCurrent ε η
    block hblockValues
  have hXValues : ∀ i, X.valueUnit i =
      lemma714TypeIITargetValues b s D.two_le hsCurrent ε η i := by
    intro i
    exact b.lemma714TypeIIOrthogonalBasisData_valueUnit S s D.two_le hsCurrent
      ε η block hblockValues i
  have hcriteria : X.SatisfiesGoodBONGCriteria := by
    constructor
    · intro i hi
      unfold OrthogonalBasisData.order
      rw [hXValues i, hXValues ⟨i.val + 2, hi⟩]
      exact b.lemma714TypeIITargetValues_weakTwoStep R s D hthird hsCurrent
        hcurrent ε η hεUnit hηUnit i hi
    · intro i hi
      unfold OrthogonalBasisData.adjacentParameter
      rw [hXValues i, hXValues ⟨i.val + 1, hi⟩]
      exact b.lemma714TypeIITargetValues_adjacentAdmissible R s D hthird
        hsCurrent hcurrent ε η hεUnit hηUnit hηDefect i hi
  rcases (X.hasGoodRealization_iff_beli2006Criteria).2 hcriteria with
    ⟨N, raw, hreal, hgood⟩
  let target : GoodBONG
      ((q.restrict S.right.carrier S.right.nondegenerate).orthogonalSum
        (q.restrict S.left.carrier S.left.nondegenerate)) N (n + 3) :=
    ⟨raw, hgood⟩
  refine ⟨N, target, ?_, ?_⟩
  · intro i
    apply Units.ext
    change raw.value i =
      (lemma714TypeIITargetValues b s D.two_le hsCurrent ε η i : K)
    rw [← X.value_eq_of_isRealizedBy hreal i]
    exact congrArg Units.val (hXValues i)
  · intro i
    calc
      target.toBONG.ambientVector i = X.basis i := hreal i
      _ = lemma714TypeIITargetVector b S s D.two_le hsCurrent block i := by
        exact b.lemma714TypeIITargetBasis_apply S s D.two_le hsCurrent ε η
          block hblockValues i

