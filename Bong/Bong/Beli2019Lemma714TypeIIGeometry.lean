  have hvalNe : i.val ≠ j.val := by
    intro h
    exact hij (Fin.ext h)
  rcases lt_or_gt_of_ne hvalNe with hlt | hgt
  · exact b.lemma714TypeIITargetVector_bilin_eq_zero_of_lt
      S s hsTwo hsCurrent block i j hlt
  · rw [((q.restrict S.right.carrier S.right.nondegenerate).orthogonalSum
      (q.restrict S.left.carrier S.left.nondegenerate)).isSymm.eq]
    exact b.lemma714TypeIITargetVector_bilin_eq_zero_of_lt
