import Bong.Bong.Basis
import Bong.Bong.SectionTwo
import Bong.Lattice.OrthogonalBasis

/-!
# Integral lattices generated by BONG bases

This file computes the scale and norm ideals of the integral lattice generated
by the ambient orthogonal basis of a BONG.  In dimension one, the recursive
BONG lattice itself is exactly this basis lattice.
-/

namespace Bong

open Dyadic
open Module

universe u v

variable {K : Type u} [Field K] [CharZero K] [ValuativeRel K]
  [TopologicalSpace K] [DyadicContext K]
  {V : Type v} [AddCommGroup V] [Module K V]
  {q : QuadraticSpace K V} {L : Lattice K V} {n : Nat}

namespace BONG

/-- The scale ideal of a BONG basis lattice is generated by its values. -/
theorem scaleIdeal_basisLattice (b : BONG V q L n) :
    Lattice.scaleIdeal q (Lattice.basisLattice b.basis) =
      Submodule.span (IntegerRing K) (Set.range b.value) := by
  rw [Lattice.scaleIdeal_basisLattice_of_iIsOrtho q b.basis
    b.ambientVector_iIsOrtho]
  congr 1
  ext a
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i, by
      simpa only [ambientVector] using
        (b.quadratic_ambientVector i).symm⟩
  · rintro ⟨i, rfl⟩
    exact ⟨i, by
      simpa only [ambientVector] using b.quadratic_ambientVector i⟩

/-- The norm ideal of a BONG basis lattice is generated by its values. -/
theorem normIdeal_basisLattice (b : BONG V q L n) :
    Lattice.normIdeal q (Lattice.basisLattice b.basis) =
      Submodule.span (IntegerRing K) (Set.range b.value) := by
  rw [Lattice.normIdeal_basisLattice_of_iIsOrtho q b.basis
    b.ambientVector_iIsOrtho]
  congr 1
  ext a
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i, by
      simpa only [ambientVector] using
        (b.quadratic_ambientVector i).symm⟩
  · rintro ⟨i, rfl⟩
    exact ⟨i, by
      simpa only [ambientVector] using b.quadratic_ambientVector i⟩

/-- Projecting a BONG basis lattice removes its first basis vector. -/
theorem projectedLattice_basisLattice (b : BONG V q L (n + 1)) :
    (Lattice.basisLattice b.basis).projectedLattice q b.head
        b.head_isAnisotropic =
      Lattice.basisLattice b.tail.basis := by
  cases b with
  | @cons V _ _ q L n x generator anisotropic tail =>
      apply Lattice.ext
      change
        (Submodule.span (IntegerRing K)
          (Set.range (BONG.cons x generator anisotropic tail).basis)).map
            ((q.projectionToOrthogonal x anisotropic).restrictScalars
              (IntegerRing K)) =
          Submodule.span (IntegerRing K) (Set.range tail.basis)
      rw [Submodule.map_span]
      apply le_antisymm
      · rw [Submodule.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        cases i using Fin.cases with
        | zero =>
            have hbasis :
                (BONG.cons x generator anisotropic tail).basis 0 = x := by
              simpa only [ambientVector] using
                (ambientVector_cons_zero (K := K) (b := tail))
            rw [hbasis]
            change q.projectionToOrthogonal x anisotropic x ∈ _
            have hzero : q.projectionToOrthogonal x anisotropic x = 0 := by
              apply Subtype.ext
              exact q.orthogonalProjection_self anisotropic
            rw [hzero]
            exact Submodule.zero_mem _
        | succ i =>
            have hbasis :
                (BONG.cons x generator anisotropic tail).basis i.succ =
                  (tail.ambientVector i : V) := by
              simpa only [ambientVector] using
                (ambientVector_cons_succ (K := K) (b := tail) i)
            rw [hbasis]
            change q.projectionToOrthogonal x anisotropic
              (tail.ambientVector i : V) ∈ _
            have hself : q.projectionToOrthogonal x anisotropic
                (tail.ambientVector i : V) = tail.ambientVector i := by
              apply Subtype.ext
              exact q.orthogonalProjection_eq_self
                (tail.ambientVector i).property
            rw [hself]
            exact Submodule.subset_span ⟨i, rfl⟩
      · rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        apply Submodule.subset_span
        refine ⟨(tail.ambientVector i : V), ?_, ?_⟩
        · exact ⟨i.succ, by
            simpa only [ambientVector] using
              (ambientVector_cons_succ (K := K) (b := tail) i)⟩
        · apply Subtype.ext
          exact q.orthogonalProjection_eq_self
            (tail.ambientVector i).property

private theorem range_value_unary (b : BONG V q L 1) :
    Set.range b.value = {b.value 0} := by
  ext a
  constructor
  · rintro ⟨i, rfl⟩
    have hi : i = 0 := Subsingleton.elim i 0
    subst i
    rfl
  · intro ha
    rw [Set.mem_singleton_iff] at ha
    exact ⟨0, ha.symm⟩

private theorem range_basis_unary (b : BONG V q L 1) :
    Set.range b.basis = {b.head} := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    have hi : i = 0 := Subsingleton.elim i 0
    subst i
    rw [Set.mem_singleton_iff]
    simpa only [ambientVector] using b.ambientVector_zero_eq_head
  · intro hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    refine ⟨0, ?_⟩
    simpa only [ambientVector] using b.ambientVector_zero_eq_head

private theorem ambientVector_zero_eq_head_unary (b : BONG V q L 1) :
    b.ambientVector 0 = b.head := by
  cases b with
  | cons x _ _ _ =>
      rw [ambientVector_cons_zero]
      change x = x
      rfl

/-- A unary BONG vector generates the norm ideal of its basis lattice. -/
theorem head_isNormGenerator_basisLattice (b : BONG V q L 1) :
    Lattice.IsNormGenerator q (Lattice.basisLattice b.basis) b.head := by
  constructor
  · rw [← ambientVector_zero_eq_head_unary b]
    exact Submodule.subset_span ⟨0, rfl⟩
  · rw [b.normIdeal_basisLattice, range_value_unary,
      Lattice.principalIdeal]
    congr 1
    rw [← ambientVector_zero_eq_head_unary b,
      b.quadratic_ambientVector]

/-- Every unary BONG lattice is the lattice generated by its ambient basis. -/
theorem lattice_eq_basisLattice (b : BONG V q L 1) :
    L = Lattice.basisLattice b.basis := by
  have hsub : Subsingleton (q.vectorOrthogonal b.head) := by
    cases b with
    | cons _ _ _ tail =>
        cases tail with
        | nil _ _ exhausted => exact exhausted
  have hprojection :
      L.projectedLattice q b.head b.head_isAnisotropic =
        (Lattice.basisLattice b.basis).projectedLattice q b.head
          b.head_isAnisotropic := by
    apply Lattice.ext
    ext z
    have hz : z = 0 := hsub.elim z 0
    subst z
    simp
  apply Lattice.eq_of_normIdeal_eq_of_projectedLattice_eq
    q L (Lattice.basisLattice b.basis) b.head
    b.head_isNormGenerator b.head_isNormGenerator_basisLattice
    b.head_isAnisotropic
  · rw [b.head_isNormGenerator.normIdeal_eq,
      b.head_isNormGenerator_basisLattice.normIdeal_eq]
  · exact hprojection

/-- The ambient vector of a unary BONG, viewed as an integral basis of its
actual lattice. -/
noncomputable def integralBasisFinOne (b : BONG V q L 1) :
    Basis (Fin 1) (IntegerRing K) L.toSubmodule := by
  have hsub : Submodule.span (IntegerRing K) (Set.range b.basis) =
      L.toSubmodule := by
    have h := congrArg Lattice.toSubmodule b.lattice_eq_basisLattice
    exact h.symm
  exact (b.basis.restrictScalars (IntegerRing K)).map
    (LinearEquiv.ofEq _ _ hsub)

@[simp]
theorem coe_integralBasisFinOne (b : BONG V q L 1) (i : Fin 1) :
    ((b.integralBasisFinOne i : L.toSubmodule) : V) =
      b.ambientVector i := by
  simp [integralBasisFinOne, ambientVector]

@[simp]
theorem coe_integralBasisFinOne_zero (b : BONG V q L 1) :
    ((b.integralBasisFinOne 0 : L.toSubmodule) : V) = b.head := by
  rw [coe_integralBasisFinOne]
  exact b.ambientVector_zero_eq_head

/-- Unary BONG lattices with equal quadratic-value order are equal. -/
theorem lattice_eq_of_order_eq {M : Lattice K V}
    (b : BONG V q L 1) (c : BONG V q M 1)
    (horder : b.order 0 = c.order 0) : L = M := by
  let a : K := c.basis.repr b.head 0
  have hdecomp : a • c.head = b.head := by
    rw [← c.ambientVector_zero_eq_head]
    change a • c.basis 0 = b.head
    simpa [a] using c.basis.sum_repr b.head
  have ha : a ≠ 0 := by
    intro ha
    apply b.head_isAnisotropic.ne_zero
    rw [← hdecomp, ha, zero_smul]
  have hquadratic :
      q.quadratic b.head = a ^ 2 * q.quadratic c.head := by
    rw [← hdecomp, q.quadratic_smul]
  let ua : Kˣ := Units.mk0 a ha
  let ub : Kˣ := Units.mk0 (q.quadratic b.head)
    b.head_isAnisotropic
  let uc : Kˣ := Units.mk0 (q.quadratic c.head)
    c.head_isAnisotropic
  have hunits : ub = ua ^ 2 * uc := by
    apply Units.ext
    simpa [ua, ub, uc] using hquadratic
  have hquadOrder :
      ord K (q.quadratic b.head) =
        ord K (q.quadratic c.head) := by
    rw [← b.value_zero_eq_quadratic_head,
      ← c.value_zero_eq_quadratic_head,
      ← b.coe_order 0, ← c.coe_order 0, horder]
  have hbcOrder : ordUnit K ub = ordUnit K uc := by
    apply WithTop.coe_injective
    rw [coe_ordUnit, coe_ordUnit]
    simpa [ub, uc] using hquadOrder
  have hunitOrder := congrArg (ordUnit K) hunits
  rw [ordUnit_mul, ordUnit_pow] at hunitOrder
  have huaOrder : ordUnit K ua = 0 := by
    omega
  have haValuationUnit : IsValuationUnit K a := by
    change ord K (ua : K) = 0
    rw [← coe_ordUnit, huaOrder]
    rfl
  have haIntegral : Dyadic.IsIntegral K a := by
    rw [Dyadic.IsIntegral, haValuationUnit]
  have haInvValuationUnit : IsValuationUnit K a⁻¹ := by
    rw [IsValuationUnit, AddValuation.map_inv, haValuationUnit]
    simp
  have haInvIntegral : Dyadic.IsIntegral K a⁻¹ := by
    rw [Dyadic.IsIntegral, haInvValuationUnit]
  have hinvDecomp : a⁻¹ • b.head = c.head := by
    rw [← hdecomp, smul_smul, inv_mul_cancel₀ ha, one_smul]
  have hbasisLattice :
      Lattice.basisLattice b.basis =
        Lattice.basisLattice c.basis := by
    apply Lattice.ext
    change Submodule.span (IntegerRing K) (Set.range b.basis) =
      Submodule.span (IntegerRing K) (Set.range c.basis)
    rw [range_basis_unary, range_basis_unary]
    apply le_antisymm
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      apply Submodule.mem_span_singleton.mpr
      refine ⟨⟨a, (mem_integerRing_iff K).2 haIntegral⟩, ?_⟩
      change a • c.head = b.head
      exact hdecomp
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      apply Submodule.mem_span_singleton.mpr
      refine ⟨⟨a⁻¹, (mem_integerRing_iff K).2 haInvIntegral⟩, ?_⟩
      change a⁻¹ • b.head = c.head
      exact hinvDecomp
  exact b.lattice_eq_basisLattice.trans
    (hbasisLattice.trans c.lattice_eq_basisLattice.symm)

/-- Larger unary quadratic-value order gives a smaller unary lattice. -/
theorem le_of_order_ge {M : Lattice K V}
    (b : BONG V q L 1) (c : BONG V q M 1)
    (horder : c.order 0 ≤ b.order 0) : L ≤ M := by
  let a : K := c.basis.repr b.head 0
  have hdecomp : a • c.head = b.head := by
    rw [← c.ambientVector_zero_eq_head]
    change a • c.basis 0 = b.head
    simpa [a] using c.basis.sum_repr b.head
  have ha : a ≠ 0 := by
    intro ha
    apply b.head_isAnisotropic.ne_zero
    rw [← hdecomp, ha, zero_smul]
  have hquadratic :
      q.quadratic b.head = a ^ 2 * q.quadratic c.head := by
    rw [← hdecomp, q.quadratic_smul]
  let ua : Kˣ := Units.mk0 a ha
  let ub : Kˣ := Units.mk0 (q.quadratic b.head)
    b.head_isAnisotropic
  let uc : Kˣ := Units.mk0 (q.quadratic c.head)
    c.head_isAnisotropic
  have hunits : ub = ua ^ 2 * uc := by
    apply Units.ext
    simpa [ua, ub, uc] using hquadratic
  have hquadOrder :
      ord K (q.quadratic c.head) ≤
        ord K (q.quadratic b.head) := by
    rw [← b.value_zero_eq_quadratic_head,
      ← c.value_zero_eq_quadratic_head,
      ← b.coe_order 0, ← c.coe_order 0]
    exact WithTop.coe_le_coe.mpr horder
  have hbcOrder : ordUnit K uc ≤ ordUnit K ub := by
    apply WithTop.coe_le_coe.mp
    rw [coe_ordUnit, coe_ordUnit]
    simpa [ub, uc] using hquadOrder
  have hunitOrder := congrArg (ordUnit K) hunits
  rw [ordUnit_mul, ordUnit_pow] at hunitOrder
  have huaNonneg : 0 ≤ ordUnit K ua := by
    omega
  have haIntegral : Dyadic.IsIntegral K a := by
    rw [Dyadic.IsIntegral]
    change 0 ≤ ord K (ua : K)
    rw [← coe_ordUnit]
    exact WithTop.coe_nonneg.mpr huaNonneg
  rw [b.lattice_eq_basisLattice, c.lattice_eq_basisLattice]
  change Submodule.span (IntegerRing K) (Set.range b.basis) ≤
    Submodule.span (IntegerRing K) (Set.range c.basis)
  rw [range_basis_unary, range_basis_unary,
    Submodule.span_le, Set.singleton_subset_iff]
  apply Submodule.mem_span_singleton.mpr
  refine ⟨⟨a, (mem_integerRing_iff K).2 haIntegral⟩, ?_⟩
  change a • c.head = b.head
  exact hdecomp

/-- Unary lattice inclusion forces the reverse order inequality. -/
theorem order_ge_of_le {M : Lattice K V}
    (b : BONG V q L 1) (c : BONG V q M 1)
    (hLM : L ≤ M) : c.order 0 ≤ b.order 0 := by
  have hideal : Lattice.normIdeal q L ≤ Lattice.normIdeal q M :=
    Lattice.normIdeal_mono q hLM
  rw [b.head_isNormGenerator.normIdeal_eq,
    c.head_isNormGenerator.normIdeal_eq] at hideal
  have hord := (Lattice.principalIdeal_le_iff_ord_ge
    b.head_isAnisotropic c.head_isAnisotropic).1 hideal
  apply WithTop.coe_le_coe.mp
  rw [c.coe_order, b.coe_order,
    c.value_zero_eq_quadratic_head,
    b.value_zero_eq_quadratic_head]
  exact hord

/-- Unary lattice inclusion is exactly reverse quadratic-value order. -/
theorem le_iff_order_ge {M : Lattice K V}
    (b : BONG V q L 1) (c : BONG V q M 1) :
    L ≤ M ↔ c.order 0 ≤ b.order 0 :=
  ⟨b.order_ge_of_le c, fun h => b.le_of_order_ge c h⟩

/-- An anisotropic orthogonal one-element basis canonically gives a BONG of
its integral basis lattice. -/
noncomputable def ofOrthogonalBasisFinOne
    (q : QuadraticSpace K V) (basis : Basis (Fin 1) K V)
    (horth : q.bilin.iIsOrtho basis)
    (hne : q.quadratic (basis 0) ≠ 0) :
    BONG V q (Lattice.basisLattice basis) 1 := by
  have hsub : Subsingleton (q.vectorOrthogonal (basis 0)) := by
    letI := basis.finiteDimensional_of_finite
    apply (Module.finrank_zero_iff (R := K)).mp
    have hdim := q.finrank_vectorOrthogonal hne
    have hfin : Module.finrank K V = 1 := by
      simpa using finrank_eq_card_basis basis
    omega
  have generator := Lattice.isNormGenerator_basisLattice_fin_one
    q basis horth
  exact BONG.cons (basis 0) generator hne
    (BONG.nil (q.orthogonalSpace (basis 0) hne)
      ((Lattice.basisLattice basis).projectedLattice q (basis 0) hne)
      hsub)

@[simp]
theorem ambientVector_ofOrthogonalBasisFinOne
    (q : QuadraticSpace K V) (basis : Basis (Fin 1) K V)
    (horth : q.bilin.iIsOrtho basis)
    (hne : q.quadratic (basis 0) ≠ 0) (i : Fin 1) :
    (ofOrthogonalBasisFinOne q basis horth hne).ambientVector i =
      basis i := by
  have hi : i = 0 := Subsingleton.elim i 0
  subst i
  rw [ofOrthogonalBasisFinOne, ambientVector_cons_zero]

end BONG

end Bong
